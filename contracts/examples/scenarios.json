[
  {
    "name": "device_one",
    "schema": "../schemas/messages.schema.json#/$defs/Device",
    "payload": {
      "device_id": "actuator_01",
      "gateway_id": "gw_01",
      "name": "模拟灯一",
      "protocol": "ble",
      "online": true,
      "last_seen_at_ms": 1794528000000,
      "capabilities": {
        "1": {
          "properties": {
            "power": {
              "type": "boolean",
              "readable": true,
              "writable": true
            }
          },
          "actions": [
            "set_power"
          ]
        }
      },
      "reported_state": {
        "1": {
          "power": false
        }
      },
      "state_revision": 42
    },
    "expected": "显示关闭状态"
  },
  {
    "name": "device_two",
    "schema": "../schemas/messages.schema.json#/$defs/Device",
    "payload": {
      "device_id": "actuator_02",
      "gateway_id": "gw_01",
      "name": "模拟灯二",
      "protocol": "ble",
      "online": true,
      "last_seen_at_ms": 1794528000000,
      "capabilities": {
        "1": {
          "properties": {
            "power": {
              "type": "boolean",
              "readable": true,
              "writable": true
            }
          },
          "actions": [
            "set_power"
          ]
        }
      },
      "reported_state": {
        "1": {
          "power": false
        }
      },
      "state_revision": 42
    },
    "expected": "独立寻址，不改变actuator_01"
  },
  {
    "name": "http_control",
    "schema": "../schemas/messages.schema.json#/$defs/CommandRequest",
    "payload": {
      "endpoint": "1",
      "action": "set_power",
      "params": {
        "power": true
      },
      "timeout_ms": 5000
    },
    "expected": "返回202及cmd_001",
    "http": {
      "method": "POST",
      "path": "/api/v1/devices/actuator_01/commands",
      "headers": {
        "Idempotency-Key": "op_001"
      }
    }
  },
  {
    "name": "http_queued",
    "schema": "../schemas/messages.schema.json#/$defs/Command",
    "payload": {
      "command_id": "cmd_001",
      "gateway_id": "gw_01",
      "device_id": "actuator_01",
      "endpoint": "1",
      "action": "set_power",
      "params": {
        "power": true
      },
      "status": "queued",
      "issued_at_ms": 1794528000000,
      "expires_at_ms": 1794528005000,
      "updated_at_ms": 1794528000000,
      "command_revision": 1,
      "reported_state": null,
      "error": null
    },
    "expected": "前端显示执行中",
    "http": {
      "status": 202
    }
  },
  {
    "name": "mqtt_command",
    "schema": "../schemas/messages.schema.json#/$defs/GatewayCommand",
    "payload": {
      "schema_version": 1,
      "command_id": "cmd_001",
      "gateway_id": "gw_01",
      "device_id": "actuator_01",
      "endpoint": "1",
      "action": "set_power",
      "params": {
        "power": true
      },
      "issued_at_ms": 1794528000000,
      "expires_at_ms": 1794528005000
    },
    "expected": "网关校验并接收"
  },
  {
    "name": "mqtt_accepted",
    "schema": "../schemas/messages.schema.json#/$defs/CommandResult",
    "payload": {
      "schema_version": 1,
      "gateway_id": "gw_01",
      "command_id": "cmd_001",
      "device_id": "actuator_01",
      "endpoint": "1",
      "result_seq": 1,
      "status": "accepted",
      "reported_state": null,
      "error": null
    },
    "expected": "仅受理，不更新实际power"
  },
  {
    "name": "mqtt_success",
    "schema": "../schemas/messages.schema.json#/$defs/CommandResult",
    "payload": {
      "schema_version": 1,
      "gateway_id": "gw_01",
      "command_id": "cmd_001",
      "device_id": "actuator_01",
      "endpoint": "1",
      "result_seq": 2,
      "status": "succeeded",
      "reported_state": {
        "power": true
      },
      "error": null
    },
    "expected": "设备已确认目标状态"
  },
  {
    "name": "mqtt_failure",
    "schema": "../schemas/messages.schema.json#/$defs/CommandResult",
    "payload": {
      "schema_version": 1,
      "gateway_id": "gw_01",
      "command_id": "cmd_001",
      "device_id": "actuator_01",
      "endpoint": "1",
      "result_seq": 2,
      "status": "failed",
      "reported_state": null,
      "error": {
        "code": "DEVICE_TIMEOUT",
        "message": "设备未响应"
      }
    },
    "expected": "失败，显示错误"
  },
  {
    "name": "mqtt_clock_unsynced",
    "schema": "../schemas/messages.schema.json#/$defs/CommandResult",
    "payload": {
      "schema_version": 1,
      "gateway_id": "gw_01",
      "command_id": "cmd_001",
      "device_id": "actuator_01",
      "endpoint": "1",
      "result_seq": 1,
      "status": "failed",
      "reported_state": null,
      "error": {
        "code": "CLOCK_UNSYNCED",
        "message": "网关时间未同步"
      }
    },
    "expected": "不执行命令"
  },
  {
    "name": "http_offline",
    "schema": "../schemas/messages.schema.json#/$defs/ApiError",
    "payload": {
      "request_id": "req_002",
      "error": {
        "code": "DEVICE_OFFLINE",
        "message": "设备当前离线"
      }
    },
    "expected": "不创建命令",
    "http": {
      "status": 409
    }
  },
  {
    "name": "command_expired",
    "schema": "../schemas/messages.schema.json#/$defs/Command",
    "payload": {
      "command_id": "cmd_001",
      "gateway_id": "gw_01",
      "device_id": "actuator_01",
      "endpoint": "1",
      "action": "set_power",
      "params": {
        "power": true
      },
      "status": "expired",
      "issued_at_ms": 1794528000000,
      "expires_at_ms": 1794528005000,
      "updated_at_ms": 1794528005000,
      "command_revision": 3,
      "reported_state": null,
      "error": {
        "code": "COMMAND_EXPIRED",
        "message": "有效期内未确认执行结果"
      }
    },
    "expected": "显示未确认执行结果；晚到反馈不改变终态"
  },
  {
    "name": "http_duplicate",
    "schema": "../schemas/messages.schema.json#/$defs/CommandRequest",
    "payload": {
      "endpoint": "1",
      "action": "set_power",
      "params": {
        "power": true
      },
      "timeout_ms": 5000
    },
    "expected": "同用户设备及op_001复用cmd_001，不产生第二条命令",
    "http": {
      "method": "POST",
      "path": "/api/v1/devices/actuator_01/commands",
      "headers": {
        "Idempotency-Key": "op_001"
      }
    }
  },
  {
    "name": "http_duplicate_conflict",
    "schema": "../schemas/messages.schema.json#/$defs/ApiError",
    "payload": {
      "request_id": "req_003",
      "error": {
        "code": "IDEMPOTENCY_CONFLICT",
        "message": "同键请求参数不同"
      }
    },
    "expected": "同op_001改为power=false时409",
    "http": {
      "status": 409
    }
  },
  {
